# mock: 모델 없이 고정 예시 / vertex: Vertex AI Gemini / openai: OpenAI 호환 서버(Ollama, vLLM)
LLM_PROVIDER=mock
# openai 설정 (로컬 Ollama 등)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# 시연: GCP vLLM (IAP 터널 → localhost:8001)
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=Qwen/Qwen3-8B
LLM_TEMPERATURE=0.9
LLM_DISABLE_THINKING=true

# placeholder: SVG 자리표시 / pool: assets/image_pool / vertex: Vertex AI Gemini 이미지
IMAGE_PROVIDER=placeholder
# vertex 설정 (인증: gcloud auth application-default login)
VERTEX_TEXT_MODEL=gemini-3.5-flash
# low / medium / high: 높일수록 느리지만 규칙을 더 잘 지킬 수 있다
VERTEX_THINKING_LEVEL=low
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_CONCURRENCY=3

NUM_OPTIONS=3
